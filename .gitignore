# Dependencies and build output
node_modules
.next
out
coverage
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*

# Normalised copies of the icons actually used. Regenerated by `npm run icons`,
# which predev/prebuild always run. The two registry.*.generated.ts files ARE
# committed: `npm run icons:check` fails verify when they go stale.
src/assets/icons-generated/

# Nothing in this build needs a secret, because there is no server to hold
# credentials for. A .env appearing is itself worth noticing.
.env
.env.*

# Editor and OS
.vscode/*
.idea
.DS_Store
.vercel
