{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite-plugin-svgr/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "incremental": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Strict, and not to be relaxed: the Evidence Invariant depends on the
       compiler refusing a screen that forgot the unrecorded case.

       Deliberately not enabled, for the reasons the Admin build recorded:
       - noUncheckedIndexedAccess: CSS Modules are typed with an index
         signature, so every `styles.foo` becomes `string | undefined` and
         invites `?? ''` at hundreds of call sites, which is the reflex
         CLAUDE.md §1 exists to stop.
       - exactOptionalPropertyTypes: conflicts with Radix's own optional props,
         and the status unions in src/data/types have no optional members. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": ["next-env.d.ts", "src", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
