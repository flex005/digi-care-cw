{
  "name": "digi-care-cw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run icons",
    "dev": "next dev",
    "prebuild": "npm run icons",
    "build": "next build",
    "start": "next start",
    "icons": "node scripts/icons/build-icons.mjs",
    "icons:check": "node scripts/icons/build-icons.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:es && npm run lint:css && npm run lint:classes && npm run lint:tokens && npm run lint:hatch && npm run lint:assignment && npm run lint:client-only && npm run lint:figma && npm run lint:caution && npm run lint:roles && npm run lint:losses",
    "lint:es": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:classes": "node scripts/check-css-classes.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:hatch": "node scripts/check-hatch.mjs",
    "lint:assignment": "node scripts/check-assignment-reach.mjs",
    "lint:client-only": "node scripts/check-client-only.mjs",
    "lint:figma": "node scripts/check-figma-export.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run icons:check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "husky",
    "lint:caution": "node scripts/check-caution-carriers.mjs",
    "lint:roles": "node scripts/check-role-names.mjs",
    "lint:losses": "node scripts/check-session-losses.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.css": "stylelint --fix",
    "*.{ts,tsx,css,json,mjs}": "prettier --write"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "date-fns": "^4.4.0",
    "next": "16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
